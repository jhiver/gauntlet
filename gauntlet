#!/usr/bin/env bash
# Gauntlet native executable wrapper
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
TOOL_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
export GAUNTLET_INVOKED_CWD="$PWD"

if [ -f "$TOOL_DIR/target/release/gauntlet" ]; then
  exec "$TOOL_DIR/target/release/gauntlet" "$@"
else
  cargo run --release --manifest-path "$TOOL_DIR/Cargo.toml" --bin gauntlet -- "$@"
fi
