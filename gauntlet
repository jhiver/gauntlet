#!/usr/bin/env bash
# Gauntlet executable wrapper: python3 -m src.cli "$@"
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
TOOL_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
export GAUNTLET_INVOKED_CWD="$PWD"
cd "$TOOL_DIR"
exec python3 -m src.cli "$@"
